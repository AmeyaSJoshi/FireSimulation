{
  "name": "earth-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:jac": "cd jac-backend && ../.jac-venv/bin/jac start main.jac --no_client --port 8010",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "validate:perimeter": "node scripts/validate-historical-perimeter.mjs",
    "validate:perimeter:independent": "node scripts/validate-independent-perimeter.mjs",
    "validate:perimeter:independent:archive": "node scripts/validate-independent-perimeter.mjs --archive",
    "validate:rothermel": "node scripts/validate-rothermel.mjs",
    "validate:rothermel:rate": "node scripts/validate-rothermel-rate.mjs",
    "validate:waf": "node scripts/validate-waf.mjs",
    "validate:global-fuelbed": "node scripts/validate-global-fuelbed.mjs",
    "validate:regional-inputs": "node scripts/validate-regional-inputs.mjs",
    "validate:regional-offline": "node scripts/validate-regional-offline.mjs",
    "validate:hackathon": "node scripts/validate-hackathon-benchmarks.mjs",
    "calibrate:hackathon": "node scripts/calibrate-hackathon-benchmarks.mjs",
    "validate:convergence": "node scripts/validate-convergence.mjs",
    "validate:jac": "node scripts/validate-jac-parity.mjs",
    "validate:jac:snapshots": "node scripts/validate-jac-frozen-snapshots.mjs",
    "validate:jac:weather": "node scripts/timeline-probe.mjs",
    "validate:jac:regional-timeline": "node scripts/validate-jac-regional-timeline.mjs",
    "validate:jac:perimeter": "node scripts/validate-jac-independent-perimeter.mjs",
    "validate:jac:benchmark": "node scripts/validate-jac-six-fire-benchmark.mjs",
    "validate:jac:benchmark:static": "node scripts/validate-jac-six-fire-benchmark.mjs --static-weather",
    "validate:progression": "node scripts/validate-historical-progression.mjs",
    "validate:progression:large": "node scripts/validate-historical-progression.mjs --size 256",
    "validate:progression:adaptive": "node scripts/validate-historical-progression.mjs --archive --auto-size",
    "validate:progression:archive": "node scripts/validate-historical-progression.mjs --archive",
    "validate:progression:containment": "node scripts/validate-historical-progression.mjs --archive --observed-containment",
    "validate:progression:mapped": "node scripts/validate-historical-progression.mjs --mapped-fuels",
    "validate:progression:hindcast": "node scripts/validate-historical-progression.mjs --archive --mapped-fuels",
    "validate:progression:fine": "node scripts/validate-historical-progression.mjs --mapped-fuels --fine-mapped",
    "validate:progression:fine-hindcast": "node scripts/validate-historical-progression.mjs --archive --mapped-fuels --fine-mapped",
    "validate:progression:fine-hindcast:global": "node scripts/validate-historical-progression.mjs --archive --mapped-fuels --fine-mapped --global-fuelbeds",
    "benchmark:fire": "node scripts/benchmark-fire-model.mjs",
    "build:landcover": "node scripts/build-landcover-map.mjs",
    "dev:auto": "vite --host 127.0.0.1 --port ${PORT:-5173} --strictPort"
  },
  "dependencies": {
    "cesium": "^1.143.0",
    "three": "^0.167.1",
    "vite": "^5.4.19",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "geotiff": "^3.0.5",
    "pngjs": "^7.0.0"
  }
}
